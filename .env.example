# Firebase Configuration
# Get these credentials from Firebase Console: https://console.firebase.google.com
# 1. Create a new Firebase project or use existing one
# 2. Go to Project Settings > General
# 3. Under "Your apps", click the web icon (</>)
# 4. Register your app and copy the configuration values
# 5. Enable Authentication > Sign-in method > Google and Microsoft
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Application Base URL
# Local: http://localhost:3000
# Production: https://stock.incomegrow.in
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Email Configuration (for Gmail)
# You need to use App Password for Gmail, not your regular password
# See: https://support.google.com/accounts/answer/185833
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# Admin Email (receives contact form notifications)
ADMIN_EMAIL=admin@yourdomain.com

# Server Port (optional, defaults to 3000)
PORT=3000

# Security Configuration
# JWT Secrets (REQUIRED - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_jwt_secret_here_at_least_64_characters_long
REFRESH_JWT_SECRET=your_refresh_jwt_secret_here_at_least_64_characters_long

# Internal API Secret for CRON jobs and server-to-server calls
INTERNAL_API_SECRET=your_internal_api_secret_here_at_least_64_characters_long

# Public API Key (optional - for public endpoints with higher rate limits)
PUBLIC_API_KEY=usk_your_public_api_key_here

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,https://stock.incomegrow.in

# Node Environment
NODE_ENV=development

# Google reCAPTCHA v3
# Get your keys from: https://www.google.com/recaptcha/admin
# Site key is public (used in frontend)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
# Secret key is private (used in backend API verification)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Razorpay Payment Gateway
# Get these from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here